    private async Task CopyParlaySlip()
    {
        if (parlayResult == null || !parlayResult.Picks.Any()) return;

        var sb = new System.Text.StringBuilder();
        sb.AppendLine("🔥 CYBER PREDICT - 1XBET MIX PARLAY SLIP (မောင်းလက်မှတ်)");
        sb.AppendLine($"📅 {parlayResult.FilterInfo}");
        sb.AppendLine($"📊 ပျမ်းမျှ အနိုင်ယုံကြည်မှုနှုန်း: {parlayResult.AverageConfidence}% Sure");
        sb.AppendLine("--------------------------------------------------");

        for (int i = 0; i < parlayResult.Picks.Count; i++)
        {
            var p = parlayResult.Picks[i];
            sb.AppendLine($"{i + 1}. {p.HomeTeam} vs {p.AwayTeam} ({p.League})");
            sb.AppendLine($"   👉 1xBet Pick: {p.SelectionName} @ {p.Odds:F2}");
            sb.AppendLine($"   ⏱️ {ToMyanmarTime(p.MatchTime):dd MMM, hh:mm tt} MMT • {p.ConfidencePercentage}% Sure");
            sb.AppendLine();
        }

        sb.AppendLine("--------------------------------------------------");
        sb.AppendLine($"💎 စုစုပေါင်း မြှောက်ကြေး (Total Odds): {parlayResult.TotalCombinedOdds:F2}x");
        sb.AppendLine($"🛡️ ပျမ်းမျှ တိကျမှုနှုန်း (Avg Confidence): {parlayResult.AverageConfidence}% Sure");
        sb.AppendLine($"🔢 မောင်းတွဲ ပွဲအရေအတွက် (Total Matches): {parlayResult.Picks.Count} ပွဲတွဲ");
        sb.AppendLine($"⚡ Powered by Google Gemini AI & FotMob Live Data");

        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", sb.ToString());
            isCopied = true;
            StateHasChanged();
            _ = Task.Delay(2500).ContinueWith(_ => { isCopied = false; InvokeAsync(StateHasChanged); });
        }
        catch { }
    }

