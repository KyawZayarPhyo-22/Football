    private DateTime ToMyanmarTime(DateTime matchTime)
    {
        var utc = matchTime.Kind == DateTimeKind.Utc ? matchTime : matchTime.ToUniversalTime();
        return utc.AddHours(6.5);
    }

    private string GetMyanmarTimeFormatted(DateTime matchTime)
    {
        var mmt = ToMyanmarTime(matchTime);
        return mmt.ToString("dd MMM, hh:mm tt");
    }

    private string GetUtcTimeFormatted(DateTime matchTime)
    {
        var utc = matchTime.Kind == DateTimeKind.Utc ? matchTime : matchTime.ToUniversalTime();
        return utc.ToString("HH:mm");
    }

    private string GetDateBadgeText(DateTime matchTime)
    {
        var mmtDate = ToMyanmarTime(matchTime).Date;
        var myanmarToday = DateTime.UtcNow.AddHours(6.5).Date;
        if (mmtDate == myanmarToday) return "🟢 ဒီနေ့ (Today)";
        if (mmtDate == myanmarToday.AddDays(1)) return "⚡ မနက်ဖြန် (Tomorrow)";
        if (mmtDate == myanmarToday.AddDays(-1)) return "🏁 မနေ့က (Yesterday)";
        return $"🗓️ {mmtDate:dd MMM}";
    }

    private string GetDateBadgeColor(DateTime matchTime)
    {
        var mmtDate = ToMyanmarTime(matchTime).Date;
        var myanmarToday = DateTime.UtcNow.AddHours(6.5).Date;
        if (mmtDate == myanmarToday) return "var(--neon-green)";
        if (mmtDate == myanmarToday.AddDays(1)) return "var(--neon-gold)";
        return "var(--neon-cyan)";
    }

    private string GetDateBadgeBorder(DateTime matchTime)
    {
        var mmtDate = ToMyanmarTime(matchTime).Date;
        var myanmarToday = DateTime.UtcNow.AddHours(6.5).Date;
        if (mmtDate == myanmarToday) return "rgba(0, 245, 160, 0.4)";
        if (mmtDate == myanmarToday.AddDays(1)) return "rgba(255, 183, 3, 0.4)";
        return "rgba(0, 210, 255, 0.3)";
    }

    private async Task PredictMatch(string matchId)
    {
        predictingMatchIds.Add(matchId);
        StateHasChanged();

        var prediction = await ApiClient.RunAiMatchPredictionAsync(matchId);
        if (prediction != null && matches != null)
        {
            var m = matches.FirstOrDefault(x => x.Id == matchId);
            if (m != null)
            {
                m.AiPrediction = prediction;
            }
        }

        predictingMatchIds.Remove(matchId);
        StateHasChanged();
    }

    private async Task PredictAllMatches()
    {
        if (matches == null || !matches.Any()) return;
        isPredictingAll = true;

        foreach (var match in filteredMatches)
        {
            if (match.AiPrediction == null)
            {
                predictingMatchIds.Add(match.Id);
                StateHasChanged();
                var pred = await ApiClient.RunAiMatchPredictionAsync(match.Id);
                if (pred != null) match.AiPrediction = pred;
                predictingMatchIds.Remove(match.Id);
                StateHasChanged();
            }
        }

        isPredictingAll = false;
    }
