                            }
                        </button>
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    private List<FootballMatchDto>? matches;
    private List<FootballCalendarDayDto> calendarDays = [];
    private string selectedDate = "";
    private string currentSelectedDateStr = "";
    private string selectedLeague = "All";
    private string searchQuery = "";
    private bool isLoading = true;
    private bool isPredictingAll = false;
    private readonly HashSet<string> predictingMatchIds = new();

    // 🎯 1xBet Mix Parlay State
    private bool isParlayModalOpen = false;
    private FootballParlayRequestDto parlayRequest = new();
    private FootballParlayResponseDto? parlayResult;
    private bool isGeneratingParlay = false;
    private bool isCopied = false;

    // 🗓️ Interactive Cyber Visual Month Calendar State
    private bool isCalendarModalOpen = false;
    private bool isMonthGridInline = false;
    private DateTime calendarViewMonth = DateTime.UtcNow.AddHours(6.5);

    public class CalendarGridDay
    {
        public DateTime Date { get; set; }
        public bool IsCurrentMonth { get; set; }
        public bool IsToday { get; set; }
        public bool IsTomorrow { get; set; }
        public int MatchCount { get; set; }
    }

    private bool isTodaySelected => selectedDate == DateTime.UtcNow.AddHours(6.5).ToString("yyyy-MM-dd");
    private bool isTomorrowSelected => selectedDate == DateTime.UtcNow.AddHours(6.5).AddDays(1).ToString("yyyy-MM-dd");
    private bool isAllSelected => selectedDate == "all";

    private IEnumerable<FootballMatchDto> filteredMatches
    {
        get
        {
            if (matches == null) return Enumerable.Empty<FootballMatchDto>();
            var result = matches.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(selectedLeague) && !selectedLeague.Equals("All", StringComparison.OrdinalIgnoreCase))
            {
                if (selectedLeague.StartsWith("Country:", StringComparison.OrdinalIgnoreCase))
                {
                    var country = selectedLeague.Substring("Country:".Length);
                    result = country switch
                    {
                        "England" => result.Where(m => m.League.Contains("English", StringComparison.OrdinalIgnoreCase) || m.League.Contains("Premier League", StringComparison.OrdinalIgnoreCase) || m.League.Contains("Championship", StringComparison.OrdinalIgnoreCase)),
                        "Spain" => result.Where(m => m.League.Contains("Spanish", StringComparison.OrdinalIgnoreCase) || m.League.Contains("La Liga", StringComparison.OrdinalIgnoreCase)),
                        "Germany" => result.Where(m => m.League.Contains("German", StringComparison.OrdinalIgnoreCase) || m.League.Contains("Bundesliga", StringComparison.OrdinalIgnoreCase)),
                        "Italy" => result.Where(m => m.League.Contains("Italian", StringComparison.OrdinalIgnoreCase) || m.League.Contains("Serie A", StringComparison.OrdinalIgnoreCase) || m.League.Contains("Serie B", StringComparison.OrdinalIgnoreCase)),
                        "France" => result.Where(m => m.League.Contains("French", StringComparison.OrdinalIgnoreCase) || m.League.Contains("Ligue", StringComparison.OrdinalIgnoreCase)),
                        "Portugal" => result.Where(m => m.League.Contains("Portuguese", StringComparison.OrdinalIgnoreCase) || m.League.Contains("Portugal", StringComparison.OrdinalIgnoreCase) || m.League.Contains("Primeira Liga", StringComparison.OrdinalIgnoreCase)),
                        "Netherlands" => result.Where(m => m.League.Contains("Dutch", StringComparison.OrdinalIgnoreCase) || m.League.Contains("Eredivisie", StringComparison.OrdinalIgnoreCase) || m.League.Contains("Netherlands", StringComparison.OrdinalIgnoreCase)),
                        "USA" => result.Where(m => m.League.Contains("USA", StringComparison.OrdinalIgnoreCase) || m.League.Contains("MLS", StringComparison.OrdinalIgnoreCase) || m.League.Contains("Major League Soccer", StringComparison.OrdinalIgnoreCase)),
                        "Turkey" => result.Where(m => m.League.Contains("Turkish", StringComparison.OrdinalIgnoreCase) || m.League.Contains("Turkey", StringComparison.OrdinalIgnoreCase) || m.League.Contains("Süper Lig", StringComparison.OrdinalIgnoreCase) || m.League.Contains("Super Lig", StringComparison.OrdinalIgnoreCase)),
                        _ => result
                    };
                }
                else if (selectedLeague.Contains("Nations League", StringComparison.OrdinalIgnoreCase))
                {
                    result = result.Where(m => m.League.Contains("Nations League", StringComparison.OrdinalIgnoreCase));
                }
                else
                {
                    result = result.Where(m => m.League.Equals(selectedLeague, StringComparison.OrdinalIgnoreCase) || m.League.Contains(selectedLeague, StringComparison.OrdinalIgnoreCase));
                }
            }

            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                result = result.Where(m =>
                    m.HomeTeam.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                    m.AwayTeam.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                    m.League.Contains(searchQuery, StringComparison.OrdinalIgnoreCase));
            }

            return result;
        }
    }

    private async Task OnLeagueDropdownChanged(ChangeEventArgs e)
    {
        selectedLeague = e.Value?.ToString() ?? "All";
        await LoadMatches();
    }

    protected override async Task OnInitializedAsync()
    {
        var myanmarToday = DateTime.UtcNow.AddHours(6.5).ToString("yyyy-MM-dd");
        selectedDate = myanmarToday;
        currentSelectedDateStr = myanmarToday;

        await LoadCalendarDays();
        await LoadMatches();
    }

    private async Task LoadCalendarDays()
    {
        try
        {
            calendarDays = await ApiClient.GetCalendarDaysAsync(21);
        }
        catch { }
    }

    private async Task LoadMatches(bool refresh = false)
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            matches = await ApiClient.GetMatchesAsync(selectedDate, selectedLeague, refresh);
        }
        catch
        {
            matches = [];
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task SelectDate(string dateStr)
    {
        selectedDate = dateStr;
        currentSelectedDateStr = dateStr;
        await LoadMatches();
    }

    private async Task SelectToday()
    {
        var todayStr = DateTime.UtcNow.AddHours(6.5).ToString("yyyy-MM-dd");
        selectedDate = todayStr;
        currentSelectedDateStr = todayStr;
        await LoadMatches();
    }

    private async Task SelectTomorrow()
    {
        var tomorrowStr = DateTime.UtcNow.AddHours(6.5).AddDays(1).ToString("yyyy-MM-dd");
        selectedDate = tomorrowStr;
        currentSelectedDateStr = tomorrowStr;
        await LoadMatches();
    }

    private async Task SelectAllUpcoming()
    {
        selectedDate = "all";
        currentSelectedDateStr = "";
        await LoadMatches();
    }

    private async Task OnDatePickerChanged(ChangeEventArgs e)
    {
        var pickedDate = e.Value?.ToString();
        if (!string.IsNullOrWhiteSpace(pickedDate))
        {
            selectedDate = pickedDate;
            currentSelectedDateStr = pickedDate;
            await LoadMatches();
        }
    }

    private async Task NavigateDay(int offset)
    {
        DateTime baseDate;
        if (DateTime.TryParse(selectedDate, out var parsed))
        {
            baseDate = parsed;
        }
        else
        {
            baseDate = DateTime.UtcNow.AddHours(6.5);
        }

        var newDate = baseDate.AddDays(offset);
        var newDateStr = newDate.ToString("yyyy-MM-dd");
        selectedDate = newDateStr;
        currentSelectedDateStr = newDateStr;
        await LoadMatches();
    }

    private async Task ForceRefreshMatches()
    {
        await LoadMatches(refresh: true);
        await LoadCalendarDays();
    }

    // ========================================================================
    // 🎯 1XBET MIX PARLAY (မောင်းတွဲ) HANDLERS
    // ========================================================================
    private bool isParlayCalendarGridOpen = true;
    private string parlayCalendarTarget = "from";
    private DateTime parlayCalendarMonth = DateTime.UtcNow.AddHours(6.5);

    private void OpenParlayModal()
    {
        var myanmarNow = DateTime.UtcNow.AddHours(6.5);
        parlayRequest = new FootballParlayRequestDto
        {
            FromDate = DateTime.TryParse(selectedDate, out _) && selectedDate != "all" ? selectedDate : myanmarNow.ToString("yyyy-MM-dd"),
            ToDate = DateTime.TryParse(selectedDate, out var dt) && selectedDate != "all" ? dt.AddDays(1).ToString("yyyy-MM-dd") : myanmarNow.AddDays(1).ToString("yyyy-MM-dd"),
            TotalMatches = 4,
            MinConfidence = 80,
            MarketPreference = "All",
            StakeAmount = 10000
        };
        parlayCalendarTarget = "from";
        parlayCalendarMonth = DateTime.TryParse(parlayRequest.FromDate, out var fDt) ? fDt : myanmarNow;
        isParlayCalendarGridOpen = true;
        isParlayModalOpen = true;
        isCopied = false;
    }

    private void ToggleParlayCalendarGrid()
    {
        isParlayCalendarGridOpen = !isParlayCalendarGridOpen;
    }

    private void SetParlayCalendarTarget(string target)
    {
        parlayCalendarTarget = target;
        isParlayCalendarGridOpen = true;
    }

    private void ChangeParlayCalendarMonth(int delta)
    {
        parlayCalendarMonth = parlayCalendarMonth.AddMonths(delta);
    }

    private void SelectParlayCalendarDate(string dateStr)
    {
        if (parlayCalendarTarget == "from")
        {
            parlayRequest.FromDate = dateStr;
            if (DateTime.TryParse(parlayRequest.ToDate, out var toDt) && DateTime.Parse(dateStr) > toDt)
            {
                parlayRequest.ToDate = dateStr;
            }
            parlayCalendarTarget = "to";
        }
        else
        {
            parlayRequest.ToDate = dateStr;
            if (DateTime.TryParse(parlayRequest.FromDate, out var fromDt) && DateTime.Parse(dateStr) < fromDt)
            {
                parlayRequest.FromDate = dateStr;
            }
        }
    }

    private bool IsDateBetween(string dateStr, string startStr, string endStr)
    {
        if (DateTime.TryParse(dateStr, out var d) && 
            DateTime.TryParse(startStr, out var s) && 
            DateTime.TryParse(endStr, out var e))
        {
            return d >= s && d <= e;
        }
        return false;
    }

    private string FormatParlayDateDisplay(string dateStr)
    {
        if (DateTime.TryParse(dateStr, out var dt))
        {
            var dow = dt.DayOfWeek switch
            {
                DayOfWeek.Monday => "တနင်္လာ",
                DayOfWeek.Tuesday => "အင်္ဂါ",
                DayOfWeek.Wednesday => "ဗုဒ္ဓဟူး",
                DayOfWeek.Thursday => "ကြာသပတေး",
                DayOfWeek.Friday => "သောကြာ",
                DayOfWeek.Saturday => "စနေ",
                DayOfWeek.Sunday => "တနင်္ဂနွေ",
                _ => ""
            };
            var mName = dt.ToString("MMM", new System.Globalization.CultureInfo("en-US"));
            return $"{dt.Day} {mName} {dt.Year} ({dow})";
        }
        return dateStr;
    }

