    private List<CalendarGridDay> GetMonthCalendarDays(DateTime monthDate)
    {
        var result = new List<CalendarGridDay>();
        var firstDayOfMonth = new DateTime(monthDate.Year, monthDate.Month, 1);
        var myanmarNow = DateTime.UtcNow.AddHours(6.5).Date;

        int dayOfWeek = (int)firstDayOfMonth.DayOfWeek;
        int offset = dayOfWeek == 0 ? 6 : dayOfWeek - 1;
        var startGridDate = firstDayOfMonth.AddDays(-offset);

        for (int i = 0; i < 35; i++)
        {
            var cellDate = startGridDate.AddDays(i);
            var dateStr = cellDate.ToString("yyyy-MM-dd");
            var dayDto = calendarDays.FirstOrDefault(d => d.Date == dateStr);

            result.Add(new CalendarGridDay
            {
                Date = cellDate,
                IsCurrentMonth = (cellDate.Month == monthDate.Month),
                IsToday = (cellDate.Date == myanmarNow),
                IsTomorrow = (cellDate.Date == myanmarNow.AddDays(1)),
                MatchCount = dayDto?.MatchCount ?? 0
            });
        }

        return result;
    }

