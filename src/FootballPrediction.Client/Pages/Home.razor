                <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px; margin-bottom: 12px;">
                    <div>
                        <span style="font-size: 14px; font-weight: 700; color: #fff;">🗓️ မောင်းတွဲ ကာလ သတ်မှတ်ရန် (Date Range):</span>
                        <span style="font-size: 12px; color: var(--neon-cyan); margin-left: 8px;">
                            @(parlayCalendarTarget == "from" ? "👉 စတင်မည့်ရက် (From Date) ကို ပြက္ခဒိန်တွင် ကလစ်နှိပ်ပါ" : "👉 ပြီးဆုံးမည့်ရက် (To Date) ကို ပြက္ခဒိန်တွင် ကလစ်နှိပ်ပါ")
                        </span>
                    </div>
                    <div style="display: flex; gap: 6px;">
                        <button type="button" class="btn-cal-jump @(isParlayCalendarGridOpen ? "active" : "")" 
                                style="font-size: 11px; padding: 3px 10px;" @onclick="ToggleParlayCalendarGrid">
                            @(isParlayCalendarGridOpen ? "▲ ပြက္ခဒိန် သိမ်းမည်" : "▼ ပြက္ခဒိန် ဖွင့်မည်")
                        </button>
                    </div>
                </div>

                <!-- Two Date Selection Cards (From Date & To Date) -->
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 12px;">
                    <!-- From Date Card -->
                    <div class="parlay-date-card @(parlayCalendarTarget == "from" ? "active-target" : "")"
                         @onclick='() => SetParlayCalendarTarget("from")' title="စတင်မည့်ရက် ပြောင်းရန် ကလစ်နှိပ်ပါ">
                        <div>
                            <div style="font-size: 11px; color: var(--text-secondary); display: flex; align-items: center; gap: 4px;">
                                <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: var(--neon-green);"></span>
                                <span>စတင်မည့်ရက် (From Date)</span>
                            </div>
                            <div style="font-size: 15px; font-weight: 800; color: #fff; margin-top: 4px; font-family: var(--font-tech);">
                                @FormatParlayDateDisplay(parlayRequest.FromDate)
                            </div>
                        </div>
                        <span style="font-size: 18px; color: var(--neon-green);">📅</span>
                    </div>

                    <!-- To Date Card -->
                    <div class="parlay-date-card @(parlayCalendarTarget == "to" ? "active-target" : "")"
                         @onclick='() => SetParlayCalendarTarget("to")' title="ပြီးဆုံးမည့်ရက် ပြောင်းရန် ကလစ်နှိပ်ပါ">
                        <div>
                            <div style="font-size: 11px; color: var(--text-secondary); display: flex; align-items: center; gap: 4px;">
                                <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: var(--neon-gold);"></span>
                                <span>ပြီးဆုံးမည့်ရက် (To Date)</span>
                            </div>
                            <div style="font-size: 15px; font-weight: 800; color: #fff; margin-top: 4px; font-family: var(--font-tech);">
                                @FormatParlayDateDisplay(parlayRequest.ToDate)
                            </div>
                        </div>
                        <span style="font-size: 18px; color: var(--neon-gold);">📅</span>
                    </div>
                </div>

                <!-- Fast Range Presets -->
                <div style="display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: @(isParlayCalendarGridOpen ? "14px" : "0px");">
                    <span style="font-size: 11px; color: var(--text-secondary); align-self: center; margin-right: 4px;">အမြန်ရွေး:</span>
                    <button type="button" class="btn-cal-jump" style="font-size: 11px; padding: 3px 10px;" @onclick="SetParlayRangeToday">🟢 ဒီနေ့</button>
                    <button type="button" class="btn-cal-jump" style="font-size: 11px; padding: 3px 10px;" @onclick="SetParlayRangeTomorrow">⚡ မနက်ဖြန်</button>
                    <button type="button" class="btn-cal-jump" style="font-size: 11px; padding: 3px 10px;" @onclick="SetParlayRangeNext3Days">🗓️ လာမည့် ၃ ရက်</button>
                    <button type="button" class="btn-cal-jump" style="font-size: 11px; padding: 3px 10px;" @onclick="SetParlayRangeNext7Days">🌟 လာမည့် ၇ ရက်</button>
                    <button type="button" class="btn-cal-jump" style="font-size: 11px; padding: 3px 10px;" @onclick="SetParlayRangeNext14Days">🏆 လာမည့် ၂ ပတ်</button>
                </div>

                @if (isParlayCalendarGridOpen)
                {
                    <!-- Visual Month Calendar Grid inside Parlay Modal -->
                    <div style="margin-top: 10px; padding-top: 12px; border-top: 1px solid rgba(255, 255, 255, 0.08);">
                        <!-- Month Header -->
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                            <button type="button" class="btn-cal-jump" style="font-size: 11px; padding: 3px 8px;" @onclick="() => ChangeParlayCalendarMonth(-1)">
                                ◀ ယခင်လ
                            </button>
                            <div style="font-family: var(--font-tech); font-size: 15px; font-weight: 700; color: #fff;">
                                <span style="color: var(--neon-cyan);">@parlayCalendarMonth.ToString("MMMM yyyy", new System.Globalization.CultureInfo("en-US"))</span>
                                <span style="font-size: 12px; color: var(--text-secondary); margin-left: 6px;">(@GetMyanmarMonthYearName(parlayCalendarMonth))</span>
                            </div>
                            <button type="button" class="btn-cal-jump" style="font-size: 11px; padding: 3px 8px;" @onclick="() => ChangeParlayCalendarMonth(1)">
                                နောက်လ ▶
                            </button>
                        </div>

                        <!-- DOW Headers -->
                        <div style="display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px; text-align: center; margin-bottom: 6px;">
                            @foreach (var dow in new[] { "MON", "TUE", "WED", "THU", "FRI", "SAT", "SUN" })
                            {
                                <div style="font-family: var(--font-tech); font-size: 10px; font-weight: 700; color: var(--neon-cyan); padding: 3px 0; background: rgba(0,210,255,0.06); border-radius: 4px;">
                                    @dow
                                </div>
                            }
                        </div>

                        <!-- Days Grid -->
                        <div style="display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px;">
                            @foreach (var cell in GetMonthCalendarDays(parlayCalendarMonth))
                            {
                                var cellDateStr = cell.Date.ToString("yyyy-MM-dd");
                                var isFrom = (parlayRequest.FromDate == cellDateStr);
                                var isTo = (parlayRequest.ToDate == cellDateStr);
                                var inRange = IsDateBetween(cellDateStr, parlayRequest.FromDate, parlayRequest.ToDate);

                                <div class="parlay-calendar-cell @(isFrom || isTo ? "is-endpoint" : inRange ? "in-range" : "")"
                                     style="background: @(isFrom || isTo ? "linear-gradient(180deg, rgba(0,210,255,0.35) 0%, rgba(9,17,36,0.95) 100%)" : inRange ? "rgba(0,210,255,0.12)" : cell.IsCurrentMonth ? "rgba(7,10,19,0.7)" : "rgba(7,10,19,0.25)");
                                            border: 1px solid @(isFrom ? "var(--neon-green)" : isTo ? "var(--neon-gold)" : inRange ? "rgba(0,210,255,0.4)" : cell.IsToday ? "var(--neon-green)" : cell.IsCurrentMonth ? "rgba(255,255,255,0.08)" : "transparent");"
                                     @onclick="() => SelectParlayCalendarDate(cellDateStr)">
                                    <div style="display: flex; justify-content: space-between; align-items: center; width: 100%; padding: 0 3px;">
                                        <span style="font-size: 12px; font-weight: 800; color: @(isFrom || isTo ? "#fff" : cell.IsCurrentMonth ? "#fff" : "rgba(255,255,255,0.25)"); font-family: var(--font-tech);">
                                            @cell.Date.Day
                                        </span>
                                        @if (isFrom)
                                        {
                                            <span style="font-size: 7px; font-weight: 800; background: rgba(0,245,155,0.3); color: var(--neon-green); border: 1px solid var(--neon-green); padding: 0 2px; border-radius: 2px;">FROM</span>
                                        }
                                        else if (isTo)
                                        {
                                            <span style="font-size: 7px; font-weight: 800; background: rgba(255,183,3,0.3); color: var(--neon-gold); border: 1px solid var(--neon-gold); padding: 0 2px; border-radius: 2px;">TO</span>
                                        }
                                        else if (cell.IsToday)
                                        {
                                            <span style="font-size: 7px; font-weight: 800; color: var(--neon-green);">TODAY</span>
                                        }
                                    </div>
                                    <div style="margin-top: 2px;">
                                        @if (cell.MatchCount > 0)
                                        {
                                            <span style="font-size: 9px; font-weight: 700; color: var(--neon-green); font-family: var(--font-code);">
                                                @cell.MatchCount ပွဲ
                                            </span>
                                        }
                                        else if (cell.IsCurrentMonth)
                                        {
                                            <span style="font-size: 8px; color: var(--text-muted);">-</span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- Total Matches Selector (Customizable: Min 4, Max 50) -->
            <div style="background: rgba(7, 10, 19, 0.65); border: 1px solid rgba(0, 210, 255, 0.25); border-radius: 12px; padding: 16px; margin-bottom: 18px;">
                <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px; margin-bottom: 12px;">
                    <div>
                        <span style="font-size: 14px; font-weight: 700; color: #fff;">🔢 မောင်းတွဲမည့် ပွဲအရေအတွက် (Total Matches):</span>
                        <span style="font-size: 18px; font-weight: 800; color: var(--neon-cyan); font-family: var(--font-tech); margin-left: 8px; text-shadow: 0 0 10px rgba(0,210,255,0.4);">
                            @parlayRequest.TotalMatches ပွဲတွဲ
                        </span>
                    </div>
                    <span style="font-size: 11px; color: var(--neon-gold); font-weight: 700; background: rgba(255,183,3,0.12); border: 1px solid rgba(255,183,3,0.35); padding: 3px 10px; border-radius: 6px;">
                        ⚡ Min: 4 ပွဲ ~ Max: 50 ပွဲ (စိတ်ကြိုက်သတ်မှတ်နိုင်)
                    </span>
                </div>

                <!-- Custom Stepper, Input Box & Range Slider -->
                <div style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">
                    <div style="display: inline-flex; align-items: center; gap: 4px; background: rgba(0, 0, 0, 0.4); padding: 4px; border-radius: 8px; border: 1px solid rgba(255, 255, 255, 0.1);">
                        <button type="button" class="btn-cal-jump" style="width: 36px; height: 36px; padding: 0; justify-content: center; font-size: 20px; font-weight: 800;" 
                                @onclick="() => AdjustTotalMatches(-1)" disabled="@(parlayRequest.TotalMatches <= 4)" title="၁ ပွဲ လျှော့မည်">
                            −
                        </button>
                        <input type="number" class="settings-input" style="width: 70px; text-align: center; font-size: 18px; font-weight: 800; color: var(--neon-cyan); padding: 4px 6px; border: none; background: transparent;"
                               min="4" max="50" value="@parlayRequest.TotalMatches" @onchange="OnTotalMatchesInputChanged" />
                        <button type="button" class="btn-cal-jump" style="width: 36px; height: 36px; padding: 0; justify-content: center; font-size: 20px; font-weight: 800;" 
                                @onclick="() => AdjustTotalMatches(1)" disabled="@(parlayRequest.TotalMatches >= 50)" title="၁ ပွဲ တိုးမည်">
                            +
                        </button>
                    </div>

                    <div style="flex-grow: 1; min-width: 180px; display: flex; align-items: center; gap: 10px;">
                        <span style="font-size: 11px; color: var(--text-muted); font-weight: 700;">4</span>
                        <input type="range" min="4" max="50" step="1" 
                               style="flex-grow: 1; accent-color: var(--neon-cyan); cursor: pointer;"
                               value="@parlayRequest.TotalMatches" 
                               @oninput="(ChangeEventArgs e) => { if (int.TryParse(e.Value?.ToString(), out var v)) SetTotalMatches(v); }" />
                        <span style="font-size: 11px; color: var(--text-muted); font-weight: 700;">50</span>
                    </div>
                </div>

                <!-- Quick Preset Chips -->
                <div class="parlay-chip-group" style="margin-top: 12px; padding-top: 10px; border-top: 1px solid rgba(255, 255, 255, 0.06);">
                    <span style="font-size: 11px; color: var(--text-secondary); align-self: center; margin-right: 4px;">အမြန်ရွေး:</span>
                    @foreach (var count in new[] { 4, 5, 6, 8, 10, 12, 15, 20, 25, 30, 40, 50 })
                    {
                        <button type="button" class="parlay-chip @(parlayRequest.TotalMatches == count ? "active" : "")" 
                                @onclick="() => SetTotalMatches(count)">
                            @count ပွဲ
                        </button>
                    }
                </div>
            </div>

            <!-- Min Confidence Filter (Stake Amount removed as requested) -->
            <div style="background: rgba(7, 10, 19, 0.65); border: 1px solid rgba(0, 210, 255, 0.25); border-radius: 12px; padding: 14px 16px; margin-bottom: 18px;">
                <label class="settings-label" style="margin-bottom: 8px;">🛡️ အနိမ့်ဆုံး ယုံကြည်မှုနှုန်း (Confidence Filter):</label>
                <div class="parlay-chip-group">
                    <button type="button" class="parlay-chip @(parlayRequest.MinConfidence == 80 ? "active" : "")" 
                            @onclick="() => parlayRequest.MinConfidence = 80">
                        🟢 80% Sure (အသေချာဆုံး)
                    </button>
                    <button type="button" class="parlay-chip @(parlayRequest.MinConfidence == 85 ? "active" : "")" 
                            @onclick="() => parlayRequest.MinConfidence = 85">
                        ⚡ 85%+ (စူပါအပိုင်)
                    </button>
                    <button type="button" class="parlay-chip @(parlayRequest.MinConfidence == 75 ? "active" : "")" 
                            @onclick="() => parlayRequest.MinConfidence = 75">
                        75%+ (ပုံမှန်)
                    </button>
                </div>
            </div>

            <div class="parlay-form-row">
                <!-- Market Preference with Grouped 1xBet Options -->
                <div style="grid-column: 1 / -1;">
                    <label class="settings-label">📊 1xBet ကစားနည်း ဈေးကွက်ရွေးချယ်ရန် (Betting Market):</label>
                    <select class="settings-input" @bind="parlayRequest.MarketPreference" style="border-color: rgba(0,210,255,0.5);">
                        <option value="All">🌟 ဈေးကွက်အားလုံး (All Markets - 1X2, Over, Cards, Corners, Specials)</option>

                        <optgroup label="⚽ အနည်းဆုံး တစ်သင်း ဂိုးသွင်းမှု (At Least One Team Over 1.5 / 2.5)">
                            <option value="AtLeastOneTeamToScore">⚽ အနည်းဆုံး တစ်သင်း Over 1.5 / 2.5 (အားလုံး)</option>
                            <option value="AtLeastOneOver15">⚽ အနည်းဆုံး တစ်သင်း Over 1.5 (Yes / No)</option>
                            <option value="AtLeastOneOver25">⚽ အနည်းဆုံး တစ်သင်း Over 2.5 (Yes / No)</option>
                        </optgroup>

                        <optgroup label="🔥 တစ်သင်းတည်း ဆက်တိုက် ဂိုးသွင်းမှု (Goals In A Row 2 / 3)">
                            <option value="GoalsInARow">🔥 ဆက်တိုက် ၂ / ၃ ဂိုး သွင်းမည် (အားလုံး)</option>
                            <option value="GoalsInARow2">🔥 ဆက်တိုက် ၂ ဂိုး သွင်းမည် (2 In A Row - Yes / No)</option>
                            <option value="GoalsInARow3">🔥 ဆက်တိုက် ၃ ဂိုး သွင်းမည် (3 In A Row - Yes / No)</option>
                        </optgroup>

                        <optgroup label="📊 အခြား 1xBet အထူးဈေးကွက်များ">
                            <option value="BothTeamsToScore">🥅 နှစ်သင်းစလုံး ဂိုးသွင်းမည် (Both Teams To Score - BTTS / GG)</option>
                            <option value="Corners">🚩 ဒေါင့်ကန်ဘော အပေါ် (Corners Over 8.5/9.5)</option>
                            <option value="YellowCards">🟨 အဝါကတ်ပြား အပေါ် (Yellow Cards Over 3.5/4.5)</option>
                            <option value="Penalty">🎯 ပင်နယ်တီ ရ/မရ (Penalty Awarded in Match - Yes / No)</option>
                            <option value="GoalOutsidePenaltyArea">🚀 ပင်နယ်တီစည်းပြင်ပမှ သွင်းဂိုး (Goal Scored Outside Penalty Area)</option>
                            <option value="SubstitutePlayerToScore">🔄 လူစားဝင် ကစားသမား ဂိုးသွင်းမည် (Substitute Player To Score)</option>
                            <option value="GoalInBothHalves">⏱️ ပထမပိုင်းနှင့် ဒုတိယပိုင်း နှစ်ပိုင်းစလုံး ဂိုးရမည် (Goal In Both Halves)</option>
                            <option value="DrawAtLeastOneHalf">🤝 အနည်းဆုံး တစ်ပိုင်း သရေကျမည် (To Draw At Least One Half)</option>
                            <option value="1X2">🏆 1X2 & Double Chance သာ (Win / Draw)</option>
                            <option value="OverUnder">⚽ Over/Under (ဂိုးပေါင်း အပေါ်/အောက်) သာ</option>
                        </optgroup>
                    </select>
                </div>
            </div>

            <!-- Generate Button -->
            <button class="btn-cyber" style="width: 100%; padding: 12px; font-size: 15px; margin-top: 6px;" 
                    @onclick="GenerateMixParlay" disabled="@isGeneratingParlay">
                @if (isGeneratingParlay)
                {
                    <span class="spinner-border spinner-border-sm" role="status"></span>
                    <span>AI ဖြင့် ၈၀% အသေချာဆုံး မောင်းတွဲ တွက်ချက်နေသည်...</span>
                }
                else
                {
                    <span>🔥 ၈၀% အသေချာဆုံး မောင်းတွဲ ဖောက်မည် (Generate Parlay)</span>
                }
            </button>

            <!-- Parlay Result Slip Display -->
            @if (parlayResult != null)
            {
                <div class="parlay-slip-box">
                    <!-- Slip Header -->
                    <div class="parlay-slip-header">
                        <div>
                            <div style="font-size: 12px; color: var(--neon-cyan); font-family: var(--font-code);">
                                🎫 1XBET PARLAY TICKET: @parlayResult.FilterInfo
                            </div>
                            <div style="font-size: 11px; color: var(--text-muted); margin-top: 2px;">
                                Generated: @parlayResult.GeneratedAt
                            </div>
                        </div>
                        <div style="background: rgba(0, 245, 155, 0.15); border: 1px solid var(--neon-green); color: var(--neon-green); padding: 4px 10px; border-radius: 6px; font-weight: 700; font-size: 12px;">
                            🛡️ @parlayResult.AverageConfidence% AVG ACCURACY
                        </div>
                    </div>

                    <!-- Picks List -->
                    @for (int i = 0; i < parlayResult.Picks.Count; i++)
                    {
                        var pick = parlayResult.Picks[i];
                        <div class="parlay-pick-row">
                            <!-- Tier 1: Match #, Teams & League / Kickoff Time -->
                            <div style="display: flex; align-items: center; gap: 10px;">
                                <span style="font-size: 13px; font-weight: 800; color: var(--neon-cyan); font-family: var(--font-code); min-width: 28px;">
                                    #@(i + 1)
                                </span>
                                <div>
                                    <div class="pick-team-info">
                                        <img src="@pick.HomeLogo" alt="" class="pick-logo-mini" onerror="this.onerror=null;this.src='favicon.png';" />
                                        <span style="font-weight: 700; color: #fff; font-size: 14px;">@pick.HomeTeam</span>
                                        <span style="color: var(--text-muted); font-size: 11px;">vs</span>
                                        <span style="font-weight: 700; color: #fff; font-size: 14px;">@pick.AwayTeam</span>
                                        <img src="@pick.AwayLogo" alt="" class="pick-logo-mini" onerror="this.onerror=null;this.src='favicon.png';" />
                                    </div>
                                    <div style="font-size: 11px; color: var(--text-secondary); margin-top: 3px;">
                                        🏆 @pick.League • 🇲🇲 @ToMyanmarTime(pick.MatchTime).ToString("dd MMM, hh:mm tt") MMT
                                    </div>
                                </div>
                            </div>

                            <!-- Tier 2: Selection Tag, Odds & Confidence (Uniform across all rows, exactly like #5) -->
                            <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-top: 8px; padding-left: 38px;">
                                <div class="pick-selection-tag" title="@pick.AnalysisReason">
                                    🎯 @pick.SelectionName
                                </div>
                                <div class="pick-odds-badge" title="1xBet Odds">
                                    @pick.Odds.ToString("F2")
                                </div>
                                <div style="font-size: 11px; color: var(--neon-green); font-weight: 700;">
                                    @pick.ConfidencePercentage% Sure
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Combined Odds, Matches & Accuracy Calculation (Stake Amount removed) -->
                    <div class="parlay-summary-card">
                        <div>
                            <div style="font-size: 11px; color: var(--text-secondary);">စုစုပေါင်း မြှောက်ကြေး (Total Odds)</div>
                            <div class="parlay-stat-val" style="color: var(--neon-gold);">
                                @parlayResult.TotalCombinedOdds.ToString("F2")x
                            </div>
                        </div>
                        <div>
                            <div style="font-size: 11px; color: var(--text-secondary);">မောင်းတွဲ ပွဲအရေအတွက် (Total Matches)</div>
                            <div class="parlay-stat-val" style="color: var(--neon-cyan);">
                                @parlayResult.Picks.Count ပွဲတွဲ
                            </div>
                        </div>
                        <div>
                            <div style="font-size: 11px; color: var(--text-secondary);">ပျမ်းမျှ တိကျမှုနှုန်း (Avg Accuracy)</div>
                            <div class="parlay-stat-val" style="color: var(--neon-green);">
                                @parlayResult.AverageConfidence% Sure
                            </div>
                        </div>
                    </div>

                    <!-- Actions Row -->
                    <div style="display: flex; gap: 10px; justify-content: flex-end; margin-top: 16px; flex-wrap: wrap;">
                        <button class="btn-cal-jump" @onclick="CopyParlaySlip" style="background: rgba(0, 210, 255, 0.2); border-color: var(--neon-cyan); color: #fff;">
                            @if (isCopied)
                            {
                                <span>✅ ကူးယူပြီးပါပြီ (Copied!)</span>
                            }
                            else
                            {
                                <span>📋 မောင်းစလစ် ကူးယူမည် (Copy Slip)</span>
                            }
                        </button>
                        <button class="btn-cal-jump" @onclick="GenerateMixParlay" style="background: rgba(255, 183, 3, 0.2); border-color: var(--neon-gold); color: #fff;">
                            <span>🔄 နောက်တစ်စုံ ဖောက်မည် (Shuffle)</span>
                        </button>
                        <button class="btn-cal-jump" @onclick="CloseParlayModal">
                            <span>ပိတ်မည် (Close)</span>
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
}

