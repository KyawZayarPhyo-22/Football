            <button class="btn-parlay-hero" @onclick="OpenParlayModal" title="၈၀% အသေချာဆုံး 1xBet မောင်းတွဲ ဖောက်ရန်">
                <span>🎯 1xBet မောင်းတွဲဖောက်မည်</span>
            </button>

            <button class="btn-cal-jump @(isTodaySelected ? "active" : "")" @onclick="SelectToday">
                🟢 ဒီနေ့ (Today)
            </button>
            <button class="btn-cal-jump @(isTomorrowSelected ? "active" : "")" @onclick="SelectTomorrow">
                ⚡ မနက်ဖြန် (Tomorrow)
            </button>
            <button class="btn-cal-jump @(isAllSelected ? "active" : "")" @onclick="SelectAllUpcoming">
                🗓️ လာမည့်ရက်အားလုံး (All)
            </button>

            <!-- Interactive Cyber Calendar UI Button -->
            <button type="button" class="btn-cal-jump" @onclick="OpenCalendarModal" title="Cyber Visual ပြက္ခဒိန် ဖွင့်ရန်" 
                    style="border-color: rgba(0,210,255,0.45); background: linear-gradient(135deg, rgba(0,210,255,0.18) 0%, rgba(7,10,19,0.85) 100%); color: #fff;">
                <span>🗓️</span>
                <span style="font-weight: 700;">ပြက္ခဒိန် UI ရွေးရန်</span>
                <span style="font-size: 10px; color: var(--neon-cyan);">▼</span>
            </button>

            <button type="button" class="btn-cal-jump" @onclick="ToggleInlineCalendar" title="ပြက္ခဒိန် မြင်ကွင်း ပြောင်းရန်" style="border-color: rgba(255,183,3,0.3); color: var(--neon-gold);">
                @(isMonthGridInline ? "◄ ရက်စွဲ ဆလိုက်ဒါ (Strip)" : "📅 လပြက္ခဒိန် (Month View)")
            </button>

            <button class="btn-cal-jump" @onclick="ForceRefreshMatches" title="FotMob Live Feed အသစ် ပြန်လည်ရယူရန်" disabled="@isLoading">
                <span class="@(isLoading ? "spinner-border spinner-border-sm" : "")">🔄</span>
                <span>Live Sync</span>
            </button>
        </div>
    </div>

    @if (isMonthGridInline)
    {
        <!-- Inline Full Month Grid View -->
        <div style="background: rgba(7, 10, 19, 0.75); border: 1px solid rgba(0, 210, 255, 0.25); border-radius: 14px; padding: 16px; margin-bottom: 14px;">
            <!-- Month Header with navigation -->
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; padding-bottom: 10px; border-bottom: 1px solid rgba(255,255,255,0.06);">
                <button type="button" class="btn-cal-jump" @onclick="() => ChangeCalendarMonth(-1)">
                    ◀ ယခင်လ
                </button>
                <div style="font-family: var(--font-tech); font-size: 18px; font-weight: 800; color: #fff; display: flex; align-items: center; gap: 8px;">
                    <span style="color: var(--neon-cyan);">@calendarViewMonth.ToString("MMMM yyyy", new System.Globalization.CultureInfo("en-US"))</span>
                    <span style="font-size: 12px; color: var(--text-secondary); font-weight: 600;">(@GetMyanmarMonthYearName(calendarViewMonth))</span>
                </div>
                <button type="button" class="btn-cal-jump" @onclick="() => ChangeCalendarMonth(1)">
                    နောက်လ ▶
                </button>
            </div>

            <!-- DOW headers -->
            <div style="display: grid; grid-template-columns: repeat(7, 1fr); gap: 6px; text-align: center; margin-bottom: 8px;">
                @foreach (var dow in new[] { "MON", "TUE", "WED", "THU", "FRI", "SAT", "SUN" })
                {
                    <div style="font-family: var(--font-tech); font-size: 11px; font-weight: 700; color: var(--neon-cyan); padding: 4px 0; background: rgba(0,210,255,0.08); border-radius: 6px;">
                        @dow
                    </div>
                }
            </div>

            <!-- Days Grid -->
            <div style="display: grid; grid-template-columns: repeat(7, 1fr); gap: 6px;">
                @foreach (var cell in GetMonthCalendarDays(calendarViewMonth))
                {
                    var cellDateStr = cell.Date.ToString("yyyy-MM-dd");
                    var isSelected = (selectedDate == cellDateStr);

                    <div class="calendar-grid-cell @(isSelected ? "selected" : "") @(cell.IsToday ? "today-cell" : "")"
                         style="background: @(isSelected ? "linear-gradient(180deg, rgba(0,210,255,0.25) 0%, rgba(9,17,36,0.95) 100%)" : cell.IsCurrentMonth ? "rgba(7,10,19,0.7)" : "rgba(7,10,19,0.25)");
                                border: 1px solid @(isSelected ? "var(--neon-cyan)" : cell.IsToday ? "var(--neon-green)" : cell.IsCurrentMonth ? "rgba(255,255,255,0.08)" : "transparent");"
                         @onclick="() => SelectDate(cellDateStr)">
                        <div style="display: flex; justify-content: space-between; align-items: center; width: 100%; padding: 0 4px;">
                            <span style="font-size: 13px; font-weight: 800; color: @(isSelected ? "var(--neon-cyan)" : cell.IsCurrentMonth ? "#fff" : "rgba(255,255,255,0.25)"); font-family: var(--font-tech);">
                                @cell.Date.Day
                            </span>
                            @if (cell.IsToday)
                            {
                                <span style="font-size: 8px; font-weight: 800; background: rgba(0,245,155,0.2); color: var(--neon-green); border: 1px solid rgba(0,245,155,0.4); padding: 0 3px; border-radius: 3px;">
                                    TODAY
                                </span>
                            }
                            else if (cell.IsTomorrow)
                            {
                                <span style="font-size: 8px; font-weight: 800; background: rgba(255,183,3,0.2); color: var(--neon-gold); border: 1px solid rgba(255,183,3,0.4); padding: 0 3px; border-radius: 3px;">
                                    TMRW
                                </span>
                            }
                        </div>

                        <div style="margin-top: 4px;">
                            @if (cell.MatchCount > 0)
                            {
                                <span style="font-size: 10px; font-weight: 800; background: rgba(0,245,155,0.15); color: var(--neon-green); border: 1px solid rgba(0,245,155,0.3); padding: 1px 5px; border-radius: 6px; font-family: var(--font-code);">
                                    @cell.MatchCount ပွဲ
                                </span>
                            }
                            else if (cell.IsCurrentMonth)
                            {
                                <span style="font-size: 9px; color: var(--text-muted);">-</span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <!-- Day Slider Strip: Quick Day Chips -->
        <div class="calendar-slider-wrapper">
            <button class="calendar-nav-btn" @onclick="() => NavigateDay(-1)" title="ယခင်ရက်သို့ (Previous Day)">
                ‹
            </button>

            <div class="calendar-days-track">
                @foreach (var day in calendarDays)
                {
                    var isSelected = (selectedDate == day.Date);
                    <div class="calendar-day-card @(isSelected ? "selected" : "")" @onclick="() => SelectDate(day.Date)">
                        @if (day.IsToday)
                        {
                            <span class="day-tag day-tag-today">TODAY</span>
                        }
                        else if (day.IsTomorrow)
                        {
                            <span class="day-tag day-tag-tomorrow">TMRW</span>
                        }

                        <span class="day-dow">@day.DisplayDayOfWeek</span>
                        <span class="day-num">@day.DisplayDate</span>
                        <span class="day-matches-count @(day.MatchCount > 0 ? "has-matches" : "no-matches")">
                            @(day.MatchCount > 0 ? $"{day.MatchCount} ပွဲ" : "ပွဲမရှိ")
                        </span>
                    </div>
                }
            </div>

            <button class="calendar-nav-btn" @onclick="() => NavigateDay(1)" title="နောက်ရက်သို့ (Next Day)">
                ›
            </button>
        </div>
    }

    <!-- Filter & Search Bar -->
    <div class="calendar-filter-bar">
        <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
            <!-- League Select with Country Separation (<optgroup>) -->
            <select class="settings-input" style="width: auto; padding: 7px 14px; border-color: rgba(0,210,255,0.4);" 
                    value="@selectedLeague" @onchange="OnLeagueDropdownChanged">
                <option value="All">🏆 လိဂ်အားလုံး (All Leagues)</option>

                <optgroup label="🏴󠁧󠁢󠁥󠁮󠁧󠁿 England (အင်္ဂလန် လိဂ်များ)">
                    <option value="Country:England">🏴󠁧󠁢󠁥󠁮󠁧󠁿 အင်္ဂလန် လိဂ်အားလုံး (All England Leagues)</option>
                    <option value="English Premier League">🏴󠁧󠁢󠁥󠁮󠁧󠁿 Premier League</option>
                    <option value="English Championship">🏴󠁧󠁢󠁥󠁮󠁧󠁿 Championship</option>
                </optgroup>

                <optgroup label="🇪🇸 Spain (စပိန် လိဂ်များ)">
                    <option value="Country:Spain">🇪🇸 စပိန် လိဂ်အားလုံး (All Spain Leagues)</option>
                    <option value="Spanish La Liga">🇪🇸 La Liga</option>
                </optgroup>

                <optgroup label="🇩🇪 Germany (ဂျာမနီ လိဂ်များ)">
                    <option value="Country:Germany">🇩🇪 ဂျာမနီ လိဂ်အားလုံး (All Germany Leagues)</option>
                    <option value="German Bundesliga">🇩🇪 Bundesliga</option>
                </optgroup>

                <optgroup label="🇮🇹 Italy (အီတလီ လိဂ်များ)">
                    <option value="Country:Italy">🇮🇹 အီတလီ လိဂ်အားလုံး (All Italy Leagues)</option>
                    <option value="Italian Serie A">🇮🇹 Serie A</option>
                </optgroup>

                <optgroup label="🇫🇷 France (ပြင်သစ် လိဂ်များ)">
                    <option value="Country:France">🇫🇷 ပြင်သစ် လိဂ်အားလုံး (All France Leagues)</option>
                    <option value="French Ligue 1">🇫🇷 Ligue 1</option>
                </optgroup>

                <optgroup label="🇵🇹 Portugal (ပေါ်တူဂီ လိဂ်များ)">
                    <option value="Country:Portugal">🇵🇹 ပေါ်တူဂီ လိဂ်အားလုံး (All Portugal Leagues)</option>
                    <option value="Portuguese Primeira Liga">🇵🇹 Primeira Liga (Liga Portugal)</option>
                </optgroup>

                <optgroup label="🇳🇱 Netherlands (နယ်သာလန် လိဂ်များ)">
                    <option value="Country:Netherlands">🇳🇱 နယ်သာလန် လိဂ်အားလုံး (All Netherlands Leagues)</option>
                    <option value="Dutch Eredivisie">🇳🇱 Eredivisie</option>
                </optgroup>

                <optgroup label="🇺🇸 United States (အမေရိကန် လိဂ်များ)">
                    <option value="Country:USA">🇺🇸 အမေရိကန် လိဂ်အားလုံး (All USA Leagues)</option>
                    <option value="USA Major League Soccer">🇺🇸 Major League Soccer (MLS)</option>
                </optgroup>

                <optgroup label="🇹🇷 Turkey (တူရကီ လိဂ်များ)">
                    <option value="Country:Turkey">🇹🇷 တူရကီ လိဂ်အားလုံး (All Turkey Leagues)</option>
                    <option value="Turkish Süper Lig">🇹🇷 Süper Lig</option>
                </optgroup>

                <optgroup label="🇪🇺 European Cups (ဥရောပ ဖလားပြိုင်ပွဲများ)">
                    <option value="UEFA Champions League">⭐ Champions League</option>
                    <option value="UEFA Europa League">🟠 Europa League</option>
                    <option value="UEFA Nations League">🇪🇺 Nations League</option>
                </optgroup>
            </select>

            <!-- Search by Team Name -->
            <input type="text" class="calendar-search-input" placeholder="🔍 အသင်းနာမည် ရှာရန် (ဥပမာ- Tottenham, Liverpool, Madrid)..." 
                   @bind="searchQuery" @bind:event="oninput" />
        </div>

        <div style="display: flex; gap: 10px; align-items: center;">
            <button class="btn-parlay-hero" style="font-size: 12px; padding: 6px 14px;" @onclick="OpenParlayModal">
                <span>🎯 မောင်းတွဲဖောက်ရန်</span>
            </button>
            <button class="btn-cyber" @onclick="PredictAllMatches" disabled="@isPredictingAll">
                @if (isPredictingAll)
                {
                    <span class="spinner-border spinner-border-sm" role="status"></span>
                    <span>AI လေ့လာတွက်ချက်နေသည်...</span>
                }
                else
                {
                    <span>⚡ ဤရက်စွဲပွဲများ အားလုံး AI ခန့်မှန်းရန်</span>
                }
            </button>
        </div>
    </div>
</div>

